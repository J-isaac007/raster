{"nodes": [{"id": "contributing_contributing_guide", "label": "Contributing Guide", "file_type": "document", "source_file": "CONTRIBUTING.md", "source_location": "L1-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_code_layering", "label": "Code Layering (core / editor / ui / electron)", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L28-L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "core is pure TypeScript with no DOM/React and fully unit tested; editor is framework-free where possible; ui holds React; electron is the desktop shell."}, {"id": "contributing_sandboxed_desktop_bridge", "label": "Sandboxed Page with window.raster Bridge", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L58-L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Page has no Node access; file system access goes through window.raster and the main process only writes files the user picked or opened."}, {"id": "contributing_colors_as_numbers", "label": "Colors as 32-bit RGBA Numbers", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L64-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Byte order matches ImageData so Uint32Array layer buffers can be blitted directly."}, {"id": "contributing_editor_single_source_of_truth", "label": "Editor as Single Source of Truth", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L66-L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI reads immutable EditorState snapshots via useEditorState(selector); pixel data mutated in place and state.revision bumps."}, {"id": "contributing_undoable_changes", "label": "Every Document Change Is Undoable (sparse diff / Command)", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L70-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pixel edits go beginStroke -> dab/fill -> endStroke storing a sparse diff; structural changes push a Command with undo/redo."}, {"id": "contributing_snapshot_strokes", "label": "Strokes Paint Against a Snapshot", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L73-L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overlapping dabs never stack alpha and shape tools can redraw previews freely."}, {"id": "contributing_cels_per_frame", "label": "Layers Hold One Cel per Frame", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L76-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "layer.pixels points at the current frame's cel so tools never deal with frames; undo records the frame."}, {"id": "contributing_floating_selection", "label": "Selections Clip Strokes and Float When Moved", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L80-L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Floating buffer is committed by settle() as one undo step before any other document change."}, {"id": "contributing_adding_a_tool", "label": "Adding a Tool (ToolId, TOOLS, Toolbar icon, tests)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": "L85-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_adding_a_command", "label": "Adding a Command (createActions, MenuBar)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": "L92-L96", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_logo_generation", "label": "Logo Pixel Grid and Icon Generation", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": "L98-L102", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_semantic_versioning", "label": "Semantic Versioning Policy", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": "L113-L119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before 1.0 minor versions may break; app version and .raster format version are independent."}, {"id": "contributing_release_script", "label": "npm run release Script", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": "L121-L132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bumps package.json/lockfile and dates the changelog but does not commit or tag, so the maintainer reviews first."}], "edges": [{"source": "readme_undo_redo", "target": "contributing_undoable_changes", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CONTRIBUTING.md", "source_location": "L70-L72", "weight": 1.0}, {"source": "readme_selection", "target": "contributing_floating_selection", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CONTRIBUTING.md", "source_location": "L80-L83", "weight": 1.0}, {"source": "readme_animation", "target": "contributing_cels_per_frame", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CONTRIBUTING.md", "source_location": "L76-L79", "weight": 1.0}, {"source": "readme_pixel_art_brushes", "target": "contributing_snapshot_strokes", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "CONTRIBUTING.md", "source_location": "L73-L75", "weight": 1.0}, {"source": "docs_file_format_cel", "target": "contributing_cels_per_frame", "relation": "shares_data_with