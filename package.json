{
  "name": "raster",
  "version": "0.4.0",
  "private": true,
  "description": "Raster — a free, open source pixel art editor for Windows.",
  "license": "MIT",
  "author": "The Raster Contributors",
  "homepage": "https://github.com/J-isaac007/raster",
  "repository": {
    "type": "git",
    "url": "https://github.com/J-isaac007/raster.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "keywords": [
    "pixel-art",
    "sprite-editor",
    "image-editor",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --win --publish never -c.electronDist=node_modules/electron/dist",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.cjs --win --publish never -c.electronDist=node_modules/electron/dist --dir",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lucide-react": "^1.59.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
